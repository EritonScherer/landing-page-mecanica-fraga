---
import { Camera, MapPin, MessageCircle } from '@lucide/astro';
import { contactConfig } from '../config/contact';
import styles from './Footer.module.css';

const currentYear = new Date().getFullYear();
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetPath = (path: string) => `${basePath}${path}`;
const logoSmall = assetPath('images/logo-mecanica-fraga-280.webp');
const logoMedium = assetPath('images/logo-mecanica-fraga-420.webp');
const logoFallback = assetPath('images/logo-mecanica-fraga-420.png');
const homeHref = basePath;
---

<footer class={styles.footer}>
  <div class={`container ${styles.footerGrid}`}>
    <div>
      <a class={styles.footerLogo} href={homeHref} aria-label="Mecânica Fraga - início">
        <picture>
          <source
            srcset={`${logoSmall} 280w, ${logoMedium} 420w`}
            sizes="220px"
            type="image/webp"
          />
          <img
            class={styles.footerLogoImage}
            src={logoFallback}
            alt="Mecânica Fraga"
            width="420"
            height="125"
            loading="lazy"
          />
        </picture>
      </a>
      <p class={styles.footerText}>Oficina mecânica focada em diagnóstico preciso, manutenção transparente e atendimento profissional.</p>
    </div>

    <nav class={styles.footerNav} aria-label="Links rápidos">
      <strong>Links rápidos</strong>
      <a href="#servicos">Serviços</a>
      <a href="#sobre">Sobre</a>
      <a href="#avaliacoes">Avaliações</a>
      <a href="#contato">Contato</a>
    </nav>

    <div class={styles.footerContact}>
      <strong>Contato</strong>
      <a href={contactConfig.whatsappHref}><MessageCircle size={18} aria-hidden="true" /> WhatsApp</a>
      <a href="https://maps.google.com/?q=Av.%20Gravata%C3%AD%2C%20335%20-%20Vera%20Cruz%2C%20Gravata%C3%AD%20-%20RS%2C%2094090-490"><MapPin size={18} aria-hidden="true" /> Gravataí, RS</a>
      <a href={contactConfig.instagramUrl}><Camera size={18} aria-hidden="true" /> Instagram</a>
    </div>
  </div>

  <div class={`container ${styles.footerBottom}`}>
    <span>© {currentYear} Mecânica Fraga. Todos os direitos reservados.</span>
  </div>
</footer>
