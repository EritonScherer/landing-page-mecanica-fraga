---
import { BadgeCheck, ClipboardCheck, ScanLine, Shield } from '@lucide/astro';
import ButtonLink from './ButtonLink.astro';
import styles from './About.module.css';

const differentials = [
  { title: 'Orçamento explicado', icon: ClipboardCheck },
  { title: 'Diagnóstico por etapas', icon: ScanLine },
  { title: 'Peças de procedência', icon: BadgeCheck },
  { title: 'Garantia e pós-serviço', icon: Shield },
];
---

<section id="sobre" class={`section ${styles.about}`} aria-labelledby="about-title">
  <div class={`container ${styles.aboutGrid}`}>
    <div class={styles.aboutMedia} data-reveal>
      <img
        src="/images/hero-oficina-premium.webp"
        alt="Ambiente organizado da Mecânica Fraga com carro em manutenção"
        width="1672"
        height="941"
        loading="lazy"
      />
    </div>

    <div class={styles.aboutContent} data-reveal>
      <p class={styles.aboutEyebrow}>Sobre a Mecânica Fraga</p>
      <h2 id="about-title" class="sectionTitle">Processo claro para você decidir com segurança.</h2>
      <p class="sectionLead">
        A Mecânica Fraga combina atendimento próximo, equipamentos de diagnóstico e padrão técnico para entregar serviços bem documentados, sem surpresa no orçamento.
      </p>

      <ul class={styles.aboutList}>
        {
          differentials.map(({ title, icon: Icon }) => (
            <li class={styles.aboutListItem}>
              <Icon size={20} aria-hidden="true" />
              <span>{title}</span>
            </li>
          ))
        }
      </ul>

      <ButtonLink href="#contato" label="Falar com especialista" />
    </div>
  </div>
</section>
