---
import { CalendarCheck, Menu, X } from '@lucide/astro';
import type { NavigationItem } from '@app-types/landing';
import styles from './Header.module.css';

const navigation: NavigationItem[] = [
  { label: 'Serviços', href: '#servicos' },
  { label: 'Sobre', href: '#sobre' },
  { label: 'Avaliações', href: '#avaliacoes' },
  { label: 'Contato', href: '#contato' },
];

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetPath = (path: string) => `${basePath}${path}`;
const logoSmall = assetPath('images/logo-mecanica-fraga-280.webp');
const logoMedium = assetPath('images/logo-mecanica-fraga-420.webp');
const logoFallback = assetPath('images/logo-mecanica-fraga-420.png');
const homeHref = basePath;
---

<header class={styles.header} data-header>
  <div class={`container ${styles.headerInner}`}>
    <a class={styles.logo} href={homeHref} aria-label="Mecânica Fraga - início">
      <picture>
        <source
          srcset={`${logoSmall} 280w, ${logoMedium} 420w`}
          sizes="(max-width: 420px) 160px, 210px"
          type="image/webp"
        />
        <img
          class={styles.logoImage}
          src={logoFallback}
          alt="Mecânica Fraga"
          width="420"
          height="125"
          loading="eager"
        />
      </picture>
    </a>

    <nav class={styles.navigation} aria-label="Menu principal" data-navigation>
      {navigation.map((item) => <a class={styles.navigationLink} href={item.href}>{item.label}</a>)}
    </nav>

    <a class={styles.scheduleButton} href="#contato">
      <CalendarCheck size={18} aria-hidden="true" />
      <span>Agendar Atendimento</span>
    </a>

    <button class={styles.menuButton} type="button" aria-label="Abrir menu" aria-expanded="false" data-menu-toggle>
      <Menu class={styles.menuIconOpen} size={24} aria-hidden="true" />
      <X class={styles.menuIconClose} size={24} aria-hidden="true" />
    </button>
  </div>
</header>
